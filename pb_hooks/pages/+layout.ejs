<%
  const title = meta('title')
  const description =
    meta('description') ||
    'PocketCon 2027 is a free livestream about PocketBase. Saturday, February 6, 2027, on Discord.'
%><!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title ? `${title} · PocketCon 2027` : 'PocketCon 2027 · February 6, 2027' %></title>
    <meta name="description" content="<%= description %>" />
    <meta property="og:title" content="<%= title || 'PocketCon 2027' %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/site.css" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">Pocket<span>Con</span></a>
      <nav class="nav">
        <a href="/#agenda">Agenda</a>
        <a href="/topics">Topics</a>
        <a href="/speak">Speak</a>
        <a href="/register" class="account" data-account>Register</a>
      </nav>
    </header>

    <main><%- slot %></main>

    <footer>
      <p>
        Sponsored by <a href="https://pockethost.io">PocketHost</a>. PocketBase is an independent open source project.
        <a href="https://github.com/pockethost/pocketcon">Source</a>.
      </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/pocketbase@0.26.2/dist/pocketbase.umd.js"></script>
    <script src="/app.js"></script>
  </body>
</html>
