<%
  const event = {
    date: 'Saturday, February 6, 2027',
    // Start time is announced Jan 1. Until then the countdown runs to the start of the day (UTC).
    startsAt: '2027-02-06T00:00:00Z',
    discord: 'https://discord.gg/XkAetnQEuc',
  }
  const agenda = [
    { kind: 'Keynote', title: 'PocketBase in 2027', speaker: 'Speaker TBD' },
    { kind: 'Presentation', title: 'PocketOne, the community fork of PocketBase', speaker: 'Ben Allfree' },
    { kind: 'Presentation', title: 'Extremely fast multisite hosting', speaker: 'Ben Allfree, creator of PocketHost' },
  ]
%>
<section class="hero">
  <h1 class="visually-hidden">PocketCon 2027 · <%= event.date %> · free livestream on Discord</h1>
  <div class="splash"><%- resolve('splash.svg', { mode: 'raw' }) %></div>
  <p class="lede">A day for the PocketBase community: where it stands, where it's going, and what people are building with it.</p>

  <div class="countdown" id="countdown" data-starts="<%= event.startsAt %>" aria-live="polite">
    <div><b data-unit="d">--</b><span>days</span></div>
    <div><b data-unit="h">--</b><span>hours</span></div>
    <div><b data-unit="m">--</b><span>min</span></div>
    <div><b data-unit="s">--</b><span>sec</span></div>
  </div>

  <div class="actions">
    <a class="btn primary" href="/register">Register</a>
    <a class="btn" href="<%= event.discord %>">Join the Discord</a>
    <a class="btn" href="/pocketcon-2027.ics">Add to calendar</a>
  </div>
  <p class="note">Start time and stream link go out on January 1.</p>
</section>

<section class="agenda" id="agenda">
  <h2>Agenda</h2>
  <ol>
    <% agenda.forEach((item, i) => { %>
      <li>
        <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <p class="tag"><%= item.kind %></p>
          <h3><%= item.title %></h3>
          <p><%= item.speaker %></p>
        </div>
      </li>
    <% }) %>
    <li class="open-slot">
      <a href="/speak">
        <span class="num"><%= String(agenda.length + 1).padStart(2, '0') %></span>
        <div>
          <p class="tag">Open slot</p>
          <h3>Your talk here</h3>
          <p>Built something with PocketBase? Propose a talk, lightning talk or demo →</p>
        </div>
      </a>
    </li>
  </ol>
</section>

<script src="/countdown.js?v=2026-11-14e" defer></script>
