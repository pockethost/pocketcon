<% meta('title', 'Register') %>
<section class="page">
  <h1 class="page-title">Register</h1>
  <p class="lede">Free. You'll get the stream link and schedule by email.</p>

  <div data-signed-in hidden>
    <p class="ok">You're registered as <b data-email></b>. See you on February 6.</p>
    <div class="actions">
      <a class="btn primary" href="/offers">See attendee offers</a>
      <a class="btn highlight" href="/speak">Propose a talk</a>
      <button class="btn" type="button" data-sign-out>Sign out</button>
    </div>
  </div>

  <div class="oauth" data-oauth hidden>
    <button class="btn oauth-btn" type="button" data-provider="google" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.4-1.66 4.1-5.5 4.1-3.31 0-6-2.74-6-6.2s2.69-6.2 6-6.2c1.88 0 3.15.8 3.87 1.49l2.64-2.54C16.84 3.2 14.65 2.2 12 2.2 6.6 2.2 2.2 6.6 2.2 12s4.4 9.8 9.8 9.8c5.66 0 9.4-3.98 9.4-9.58 0-.64-.07-1.13-.16-1.62H12z"/></svg>
      Continue with Google
    </button>
    <button class="btn oauth-btn" type="button" data-provider="github" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      Continue with GitHub
    </button>
    <p class="or"><span>or with email</span></p>
    <p class="error" data-oauth-error hidden></p>
  </div>

  <form class="form" id="auth-form" data-signed-out>
    <label>Email <input name="email" type="email" autocomplete="email" required /></label>
    <label>Password <input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
    <p class="hint">At least 8 characters.</p>
    <div class="actions">
      <button class="btn primary" type="submit" data-mode="register">Register</button>
      <button class="btn" type="submit" data-mode="signin">I'm already registered</button>
    </div>
    <p class="error" data-error hidden></p>
  </form>
</section>

<script>
  document.addEventListener('pocketcon:ready', () => {
    const form = document.getElementById('auth-form')
    const goNext = () => {
      const next = new URLSearchParams(location.search).get('next')
      location.href = next && next.startsWith('/') && !next.startsWith('//') ? next : '/offers'
    }

    // Google / GitHub buttons appear only for providers enabled on the users collection (admin UI).
    const oauth = document.querySelector('[data-oauth]')
    const oauthErr = oauth.querySelector('[data-oauth-error]')
    PocketCon.pb
      .collection('users')
      .listAuthMethods()
      .then((m) => {
        const names = (m.oauth2?.enabled ? m.oauth2.providers : []).map((p) => p.name)
        let any = false
        oauth.querySelectorAll('[data-provider]').forEach((b) => {
          const on = names.includes(b.dataset.provider)
          b.hidden = !on
          any = any || on
        })
        if (any && !PocketCon.pb.authStore.isValid) oauth.hidden = false
      })
      .catch(() => {})
    oauth.querySelectorAll('[data-provider]').forEach((b) =>
      b.addEventListener('click', async () => {
        oauthErr.hidden = true
        try {
          await PocketCon.pb.collection('users').authWithOAuth2({ provider: b.dataset.provider })
          goNext()
        } catch (err) {
          oauthErr.textContent = PocketCon.message(err)
          oauthErr.hidden = false
        }
      })
    )

    let mode = 'register'
    form.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => (mode = b.dataset.mode)))
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const { email, password } = Object.fromEntries(new FormData(form))
      await PocketCon.run(form, async () => {
        if (mode === 'register') {
          await PocketCon.pb.collection('users').create({ email, password, passwordConfirm: password })
        }
        await PocketCon.pb.collection('users').authWithPassword(email, password)
        goNext()
      })
    })
  })
</script>
